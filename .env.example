# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (default: 3000)
PORT="3000"

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"

# Provider Credentials (Server-Side Only - Placeholders Only)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
BILLBOARD_API_KEY=""
GENIUS_API_KEY=""
SOUNDCHARTS_APP_ID=""
SOUNDCHARTS_API_KEY=""

# Feature Flags
FEATURE_CONTINUOUS_RESEARCH="false"
FEATURE_HYBRID_ANALYTICS="true"
FEATURE_ARTIST_SAFETY_GUARD="true"
FEATURE_AI_GENERATION="false"
FEATURE_LIVE_STREAMING="false"
FEATURE_MAINTENANCE_MODE="false"

# Worker Cadence & Concurrency
WORKER_CONCURRENCY="4"
WORKER_POLL_INTERVAL_MS="5000"
WORKER_JOB_TIMEOUT_MS="60000"
OUTBOX_BATCH_SIZE="50"
DEAD_LETTER_THRESHOLD="5"

