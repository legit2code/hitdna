# ==============================================================================
# Agent Lifecycle Intelligence Platform (CAIM V2.0.1) Environment Configuration
# ==============================================================================

# Core Application & Network
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"

# Mandatory Server-Side Intelligence Secret
# AI Studio automatically injects this at runtime from user secrets.
# Strictly isolated to server and worker execution contexts; never exposed to client.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model Configurations (Defaults provided by packages/config)
GEMINI_MODEL_DEFAULT="gemini-2.5-flash"
GEMINI_MODEL_PRO="gemini-2.5-pro"
GEMINI_MODEL_EMBEDDING="text-embedding-004"
MODEL_TEMPERATURE=0.2
MODEL_MAX_OUTPUT_TOKENS=8192

# Asymmetric Cryptographic Signing (P26 Shipping & Attestation)
SIGNING_KEY_ID="caim-v2-dev-key"
SIGNING_ALGORITHM="Ed25519"
SIGNING_PRIVATE_KEY=""
SIGNING_PUBLIC_KEY=""

# Optional Integration & Discovery Adapters (Disabled automatically if absent)
GITHUB_TOKEN=""
HUGGINGFACE_API_KEY=""
E2B_API_KEY=""
SENTRY_DSN=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Feature Flags
FEATURE_DYNAMIC_SANDBOX=true
FEATURE_EVASION_DETECTION=true
FEATURE_TAINT_ANALYSIS=true
FEATURE_HYBRID_RAG=true
FEATURE_CONTINUOUS_MONITORING=false
FEATURE_AUTOMATED_REMEDIATION=false
FEATURE_MODEL_CARD_AIBOM=true
