{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@caim/api": ["./packages/api/src/index.ts"],
      "@caim/api/*": ["./packages/api/src/*"],
      "@caim/auth": ["./packages/auth/src/index.ts"],
      "@caim/auth/*": ["./packages/auth/src/*"],
      "@caim/caim": ["./packages/caim/src/index.ts"],
      "@caim/caim/*": ["./packages/caim/src/*"],
      "@caim/config": ["./packages/config/src/index.ts"],
      "@caim/config/*": ["./packages/config/src/*"],
      "@caim/contracts": ["./packages/contracts/src/index.ts"],
      "@caim/contracts/*": ["./packages/contracts/src/*"],
      "@caim/db": ["./packages/db/src/index.ts"],
      "@caim/db/*": ["./packages/db/src/*"],
      "@caim/lifecycle": ["./packages/lifecycle/src/index.ts"],
      "@caim/lifecycle/*": ["./packages/lifecycle/src/*"],
      "@caim/ontology": ["./packages/ontology/src/index.ts"],
      "@caim/ontology/*": ["./packages/ontology/src/*"],
      "@caim/packaging": ["./packages/packaging/src/index.ts"],
      "@caim/packaging/*": ["./packages/packaging/src/*"],
      "@caim/source": ["./packages/source/src/index.ts"],
      "@caim/source/*": ["./packages/source/src/*"],
      "@caim/syntax": ["./packages/syntax/src/index.ts"],
      "@caim/syntax/*": ["./packages/syntax/src/*"],
      "@caim/workflow": ["./packages/workflow/src/index.ts"],
      "@caim/workflow/*": ["./packages/workflow/src/*"],
      "@caim/server": ["./apps/server/index.ts"],
      "@caim/server/*": ["./apps/server/*"],
      "@caim/web": ["./apps/web/index.ts"],
      "@caim/web/*": ["./apps/web/*"],
      "@caim/cloudflare-scheduler": ["./workers/cloudflare-scheduler/src/index.ts"],
      "@caim/cloudflare-scheduler/*": ["./workers/cloudflare-scheduler/src/*"],
      "@caim/composer": ["./workers/composer/index.ts"],
      "@caim/composer/*": ["./workers/composer/*"],
      "@caim/composition": ["./workers/composition/index.ts"],
      "@caim/composition/*": ["./workers/composition/*"],
      "@caim/decision": ["./workers/decision/index.ts"],
      "@caim/decision/*": ["./workers/decision/*"],
      "@caim/discovery": ["./workers/discovery/index.ts"],
      "@caim/discovery/*": ["./workers/discovery/*"],
      "@caim/evaluation": ["./workers/evaluation/index.ts"],
      "@caim/evaluation/*": ["./workers/evaluation/*"],
      "@caim/knowledge": ["./workers/knowledge/index.ts"],
      "@caim/knowledge/*": ["./workers/knowledge/*"],
      "@caim/worker-lifecycle": ["./workers/lifecycle/index.ts"],
      "@caim/worker-lifecycle/*": ["./workers/lifecycle/*"],
      "@caim/sandbox-orchestrator": ["./workers/sandbox-orchestrator/index.ts"],
      "@caim/sandbox-orchestrator/*": ["./workers/sandbox-orchestrator/*"],
      "@caim/semantic": ["./workers/semantic/index.ts"],
      "@caim/semantic/*": ["./workers/semantic/*"],
      "@caim/static-analysis": ["./workers/static-analysis/index.ts"],
      "@caim/static-analysis/*": ["./workers/static-analysis/*"],
      "@/*": ["./*"]
    }
  }
}
