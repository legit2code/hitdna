{
  "name": "@caim/platform",
  "packageManager": "pnpm@9.15.9",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/build-server.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:fast": "NODE_ENV=test vitest run",
    "test:slow": "NODE_ENV=test SLOW_TESTS_ONLY=true vitest run",
    "test:all": "NODE_ENV=test RUN_ALL_TESTS=true vitest run",
    "test:integration": "NODE_ENV=test vitest run src/__tests__/foundation.test.ts",
    "test:e2e": "NODE_ENV=test vitest run tests/e2e-full-pipeline.test.ts",
    "scan:secrets": "tsx -e \"import { runSecretScan } from './scripts/secret-scanner.ts'; console.log(runSecretScan());\"",
    "migrations:safety": "tsx -e \"import { executeFullMigrationSafetySuite } from './packages/db/src/migration-safety.ts'; console.log(executeFullMigrationSafetySuite());\"",
    "dr:rehearse": "tsx -e \"import { disasterRecoveryEngine } from './packages/workflow/src/dr-recovery.ts'; console.log(disasterRecoveryEngine.runFullDRRehearsal());\"",
    "release:check": "tsx scripts/release-check.ts",
    "discovery:cycle": "tsx scripts/run-discovery-cycle.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run release:check && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "e2b": "^2.46.1",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "undici": "^8.11.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/autocannon": "^7.12.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "pg-mem": "^3.0.14",
    "pg-server": "^0.1.8",
    "prettier": "^3.9.10",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "9.15.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  },
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ]
}
