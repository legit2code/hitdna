{
  "name": "hit-dna-music-intelligence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/testing/**/*.test.ts",
    "test:unit": "tsx --test src/testing/unit/**/*.test.ts",
    "test:integration": "tsx --test src/testing/integration/**/*.test.ts",
    "test:e2e": "tsx --test src/testing/e2e/**/*.test.ts",
    "check": "tsx scripts/check-integrity.ts && npm run lint && npm test && npm run phase:verify P04",
    "phase:verify": "tsx tools/integrity/phase-verifier.ts",
    "integrity:architecture": "tsx tools/integrity/integrity-checker.ts architecture",
    "integrity:fixtures": "tsx tools/integrity/integrity-checker.ts fixtures",
    "integrity:provenance": "tsx tools/integrity/integrity-checker.ts provenance",
    "integrity:claims": "tsx tools/integrity/integrity-checker.ts claims",
    "integrity:metrics": "tsx tools/integrity/integrity-checker.ts metrics",
    "integrity:providers": "tsx tools/integrity/integrity-checker.ts providers",
    "integrity:ui": "tsx tools/integrity/integrity-checker.ts ui",
    "integrity:artist-safety": "tsx tools/integrity/integrity-checker.ts artist-safety",
    "integrity:snapshots": "tsx tools/integrity/integrity-checker.ts snapshots",
    "integrity:security": "tsx tools/integrity/integrity-checker.ts security",
    "integrity:all": "tsx tools/integrity/integrity-checker.ts all",
    "integrity:negative-tests": "tsx tools/integrity/negative-tests.ts",
    "clean": "rm -rf dist server.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
