diff --git a/.github/workflows/postgres-certification.yml b/.github/workflows/postgres-certification.yml
new file mode 100644
index 0000000..7c42bc3
--- /dev/null
+++ b/.github/workflows/postgres-certification.yml
@@ -0,0 +1,227 @@
+name: Authentic PostgreSQL 16 Release Certification (P104A)
+
+on:
+  workflow_dispatch:
+    inputs:
+      certification_scope:
+        description: 'Target certification scope'
+        required: true
+        default: 'FULL_MIGRATION_AND_TENANT_ISOLATION'
+        type: choice
+        options:
+          - FULL_MIGRATION_AND_TENANT_ISOLATION
+          - TENANT_ISOLATION_ONLY
+          - CATALOG_RLS_ONLY
+
+permissions:
+  contents: read
+  security-events: write
+
+concurrency:
+  group: postgres-certification-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  # ============================================================================
+  # Stage 1: Ephemeral Test Credential Generation & Secure Masking
+  # ============================================================================
+  generate-ephemeral-credentials:
+    name: Generate Ephemeral Certification Credentials
+    runs-on: ubuntu-latest
+    outputs:
+      admin_password: ${{ steps.credentials.outputs.admin_password }}
+      app_password: ${{ steps.credentials.outputs.app_password }}
+      session_token: ${{ steps.credentials.outputs.session_token }}
+    steps:
+      - name: Generate Cryptographic Credentials & Session Token
+        id: credentials
+        run: |
+          ADMIN_PW=$(openssl rand -hex 24)
+          APP_PW=$(openssl rand -hex 24)
+          SESSION_TOKEN=$(openssl rand -hex 32)
+          echo "::add-mask::$ADMIN_PW"
+          echo "::add-mask::$APP_PW"
+          echo "::add-mask::$SESSION_TOKEN"
+          echo "admin_password=$ADMIN_PW" >> "$GITHUB_OUTPUT"
+          echo "app_password=$APP_PW" >> "$GITHUB_OUTPUT"
+          echo "session_token=$SESSION_TOKEN" >> "$GITHUB_OUTPUT"
+
+  # ============================================================================
+  # Stage 2: PostgreSQL 16.8 Isolation & Catalog Certification
+  # ============================================================================
+  postgres-certification:
+    name: PostgreSQL 16.8 Isolation & Catalog Certification
+    runs-on: ubuntu-latest
+    needs: generate-ephemeral-credentials
+    timeout-minutes: 20
+
+    env:
+      DATABASE_URL: postgresql://caim_ci_admin:${{ needs.generate-ephemeral-credentials.outputs.admin_password }}@localhost:5432/caim_certification_disposable_db
+      APP_DATABASE_URL: postgresql://caim_app_user:${{ needs.generate-ephemeral-credentials.outputs.app_password }}@localhost:5432/caim_certification_disposable_db
+      CAIM_CERTIFICATION_DB_APPROVED: "true"
+      CAIM_DISPOSABLE_SESSION_TOKEN: ${{ needs.generate-ephemeral-credentials.outputs.session_token }}
+
+    services:
+      postgres:
+        image: postgres:16.8-alpine
+        env:
+          POSTGRES_USER: caim_ci_admin
+          POSTGRES_PASSWORD: ${{ needs.generate-ephemeral-credentials.outputs.admin_password }}
+          POSTGRES_DB: caim_certification_disposable_db
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd pg_isready
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 10
+
+    steps:
+      - name: Checkout Repository with Complete History
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Install Pinned pnpm Package Manager
+        uses: pnpm/action-setup@v4
+        with:
+          version: 9.15.9
+
+      - name: Setup Node.js Environment
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: 'pnpm'
+
+      - name: Frozen Dependency Installation
+        run: pnpm install --frozen-lockfile
+
+      - name: Configure Nonprivileged Application Roles (No SUPERUSER, No BYPASSRLS)
+        env:
+          TARGET_APP_PW: ${{ needs.generate-ephemeral-credentials.outputs.app_password }}
+        run: |
+          pnpm exec tsx -e "
+            import pg from 'pg';
+            const client = new pg.Client({ connectionString: process.env.DATABASE_URL });
+            await client.connect();
+            const appPw = process.env.TARGET_APP_PW;
+            if (!appPw || appPw.length < 16) {
+              console.error('FATAL: Ephemeral application password missing or insecure.');
+              process.exit(1);
+            }
+            await client.query(\`
+              DO \\$\\$
+              BEGIN
+                IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'authenticated') THEN
+                  CREATE ROLE authenticated NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE LOGIN;
+                END IF;
+                IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'caim_app_user') THEN
+                  EXECUTE format('CREATE ROLE caim_app_user WITH PASSWORD %L NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE LOGIN', '\${appPw}');
+                ELSE
+                  EXECUTE format('ALTER ROLE caim_app_user WITH PASSWORD %L NOSUPERUSER NOBYPASSRLS', '\${appPw}');
+                END IF;
+                GRANT authenticated TO caim_app_user;
+              END
+              \\$\\$;
+            \`);
+            await client.end();
+            console.log('[Certification Roles] Authenticated & caim_app_user configured with ephemeral credentials.');
+          "
+
+      - name: Validate Append-Only Migration Order & DDL Safety (Empty-to-HEAD)
+        run: |
+          pnpm run migrations:safety
+
+      - name: Apply Complete Migrations from Blank DB to HEAD Using Production Migrator
+        run: |
+          pnpm exec tsx -e "
+            import { PostgresDatabaseAdapter } from './packages/db/src/postgres-adapter.ts';
+            const adapter = new PostgresDatabaseAdapter({ connectionString: process.env.DATABASE_URL });
+            const migRes = await adapter.runMigrations();
+            console.log('[Certification Migrator] Applied migrations:', migRes.applied.length, 'Skipped:', migRes.skipped.length);
+            await adapter.close();
+          "
+
+      - name: Grant Schema and Table Privileges to Nonprivileged Application Roles
+        run: |
+          pnpm exec tsx -e "
+            import pg from 'pg';
+            const client = new pg.Client({ connectionString: process.env.DATABASE_URL });
+            await client.connect();
+            await client.query(\`
+              DO \\$\\$
+              DECLARE
+                sch text;
+              BEGIN
+                FOR sch IN SELECT nspname FROM pg_namespace WHERE nspname NOT IN ('pg_catalog', 'information_schema', 'pg_toast') LOOP
+                  EXECUTE format('GRANT USAGE ON SCHEMA %I TO authenticated, caim_app_user', sch);
+                  EXECUTE format('GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA %I TO authenticated, caim_app_user', sch);
+                  EXECUTE format('GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA %I TO authenticated, caim_app_user', sch);
+                END LOOP;
+              END
+              \\$\\$;
+            \`);
+            await client.end();
+            console.log('[Certification Privileges] Non-owner permissions granted.');
+          "
+
+      - name: Verify Live PostgreSQL Catalog (relrowsecurity, relforcerowsecurity & policies)
+        run: |
+          pnpm exec tsx scripts/verify-catalog-rls.ts
+
+      - name: Execute Live Two-Session Cross-Tenant Negative Security Probes
+        run: |
+          pnpm exec tsx -e "
+            import { runCrossSessionMultiTenantNegativeTest } from './packages/db/src/migration-safety.ts';
+            const res = await runCrossSessionMultiTenantNegativeTest(process.env.APP_DATABASE_URL || process.env.DATABASE_URL);
+            console.log(res.outputSummary);
+            if (!res.passed) {
+              console.error('CRITICAL: Multi-tenant cross-session negative test failed on live PostgreSQL!');
+              process.exit(1);
+            }
+          "
+
+      - name: Execute Comprehensive Tenant Isolation & RLS Boundary Suite
+        run: |
+          pnpm exec vitest run src/__tests__/migrations.test.ts src/__tests__/p06_auth_roles_vault.test.ts src/__tests__/multi_tenant_cross_session_rls.test.ts tests/db tests/rls
+
+      - name: Execute Authentic PostgreSQL Release Certification Harness (Gate L06)
+        id: certification
+        run: |
+          pnpm exec tsx scripts/certify-real-postgres.ts
+
+      - name: Validate Machine-Readable Certification Receipt Integrity
+        if: always()
+        run: |
+          pnpm exec tsx -e "
+            import fs from 'fs';
+            const receiptPath = 'docs/certification/postgres-rls-receipt.json';
+            if (!fs.existsSync(receiptPath)) {
+              console.error('CRITICAL: Expected certification receipt was not generated at', receiptPath);
+              process.exit(1);
+            }
+            const receipt = JSON.parse(fs.readFileSync(receiptPath, 'utf8'));
+            console.log('Certification Receipt Status:', receipt.status);
+            console.log('Gate ID:', receipt.gateId);
+            console.log('Provider Type:', receipt.providerType);
+            console.log('Duration (ms):', receipt.durationMs);
+            console.log('Test Counts:', JSON.stringify(receipt.testCounts));
+            if (receipt.testCounts?.skipped > 0) {
+              console.error('CRITICAL: Unexpected skips detected in certification run:', receipt.testCounts.skipped);
+              process.exit(1);
+            }
+            if (receipt.status !== 'EXECUTED — PASS') {
+              console.error('CRITICAL: PostgreSQL certification receipt status is not PASS:', receipt.status);
+              process.exit(1);
+            }
+          "
+
+      - name: Archive Authentic PostgreSQL RLS Certification Receipt & Logs
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: standalone-postgres-certification-receipt
+          path: |
+            docs/certification/postgres-rls-receipt.json
+            docs/certification/logs/
+          retention-days: 90
